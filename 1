import {
  ArrowLeft,
  RotateCcw,
  Trophy,
  Users,
  Play,
  ChevronRight
} from "lucide-react";

import { categories, questions } from "./data/questions";

function App() {
  const [screen, setScreen] = useState("home");

  const [category, setCategory] = useState("food");

  const [currentIndex, setCurrentIndex] = useState(0);

  const [selected, setSelected] = useState([]);

  const [scores, setScores] = useState({
    left: 0,
    right: 0
  });

  const [playerName, setPlayerName] = useState("");

  const currentQuestions = questions[category];

  const currentQuestion = currentQuestions[currentIndex];

  const categoryInfo = useMemo(() => {
    return categories.find((item) => item.id === category);
  }, [category]);

  const startGame = (selectedCategory = category) => {
    setCategory(selectedCategory);
    setCurrentIndex(0);
    setSelected([]);
    setScores({
      left: 0,
      right: 0
    });
    setScreen("game");
  };

  const choose = (side) => {
    if (selected[currentIndex]) {
      return;
    }

    const nextSelected = [...selected];

    nextSelected[currentIndex] = side;

    setSelected(nextSelected);

    setScores((prev) => ({
      ...prev,
      [side]: prev[side] + 1
    }));

    setTimeout(() => {
      if (currentIndex + 1 >= currentQuestions.length) {
        setScreen("result");
      } else {
        setCurrentIndex((prev) => prev + 1);
      }
    }, 500);
  };

  const restart = () => {
    setCurrentIndex(0);

    setSelected([]);

    setScores({
      left: 0,
      right: 0
    });

    setScreen("game");
  };

  const goHome = () => {
    setScreen("home");
  };

  const progress =
    ((currentIndex + 1) / currentQuestions.length) * 100;

  if (screen === "home") {
    return (
      <div className="app">
        <div className="home-container">

          <header className="home-header">
            <div className="logo">
              <span>⚖️</span>
              <span>밸런스 게임</span>
            </div>

            <div className="live-badge">
              <span className="live-dot"></span>
              LIVE
            </div>
          </header>

          <section className="hero">
            <div className="hero-badge">
              🔥 친구들과 지금 바로!
            </div>

            <h1>
              당신이라면
              <br />
              <strong>어느 쪽?</strong>
            </h1>

            <p>
              둘 중 하나를 선택해야 하는
              <br />
              가장 어려운 선택의 시간
            </p>
          </section>

          <section className="category-section">
            <div className="section-title">
              <h2>게임 선택</h2>
              <span>3가지 테마</span>
            </div>

            <div className="category-grid">
              {categories.map((item) => (
                <button
                  key={item.id}
                  className={`category-card ${
                    category === item.id ? "active" : ""
                  }`}
                  onClick={() => startGame(item.id)}
                  style={{
                    "--category-color": item.color
                  }}
                >
                  <div className="category-icon">
                    {item.emoji}
                  </div>

                  <div className="category-text">
                    <h3>{item.title}</h3>
                    <p>{item.subtitle}</p>
                  </div>

                  <ChevronRight size={22} />
                </button>
              ))}
            </div>
          </section>

          <section className="quick-start">
            <div>
              <span className="quick-icon">
                <Play size={20} fill="white" />
              </span>

              <div>
                <strong>바로 시작하기</strong>
                <small>
                  {categoryInfo.title} 밸런스 게임
                </small>
              </div>
            </div>

            <button onClick={() => startGame(category)}>
              시작
            </button>
          </section>

          <footer>
            <Users size={16} />
            <span>친구들과 함께하면 더 재미있어요</span>
          </footer>
        </div>
      </div>
    );
  }

  if (screen === "result") {
    const total = scores.left + scores.right;

    const leftPercent =
      total === 0
        ? 0
        : Math.round((scores.left / total) * 100);

    const rightPercent =
      total === 0
        ? 0
        : Math.round((scores.right / total) * 100);

    const winner =
      scores.left >= scores.right ? "left" : "right";

    const winnerData = currentQuestions[currentQuestions.length - 1][
      winner
    ];

    return (
      <div className="app">
        <div className="result-container">

          <button className="back-button" onClick={goHome}>
            <ArrowLeft size={20} />
            홈으로
          </button>

          <div className="result-header">
            <div className="trophy">
              <Trophy size={38} />
            </div>

            <span>GAME COMPLETE</span>

            <h1>
              나의 선택 결과
            </h1>

            <p>
              {categoryInfo.emoji} {categoryInfo.title}
            </p>
          </div>

          <div className="result-card">

            <div
              className={`result-option ${
                winner === "left" ? "winner" : ""
              }`}
            >
              <div className="result-emoji">
                {winner === "left"
                  ? currentQuestions[0].left.emoji
                  : currentQuestions[0].right.emoji}
              </div>

              <div className="result-info">
                <span>
                  {winner === "left"
                    ? "LEFT"
                    : "RIGHT"}
                </span>

                <strong>
                  {winner === "left"
                    ? currentQuestions[0].left.title
                    : currentQuestions[0].right.title}
                </strong>
              </div>
            </div>

            <div className="result-score">
              <div>
                <span>LEFT</span>
                <strong>{leftPercent}%</strong>
              </div>

              <div className="result-bar">
                <div
                  className="result-left-bar"
                  style={{
                    width: `${leftPercent}%`
                  }}
                />
              </div>

              <div>
                <span>RIGHT</span>
                <strong>{rightPercent}%</strong>
              </div>
            </div>
          </div>

          <div className="result-message">
            {winner === "left" ? (
              <>
                <strong>왼쪽을 더 선호하시네요! 👈</strong>
                <p>
                  당신의 선택 스타일을 확인해보세요.
                </p>
              </>
            ) : (
              <>
                <strong>오른쪽을 더 선호하시네요! 👉</strong>
                <p>
                  당신의 선택 스타일을 확인해보세요.
                </p>
              </>
            )}
          </div>

          <div className="result-actions">
            <button
              className="primary-button"
              onClick={restart}
            >
              <RotateCcw size={19} />
              다시 하기
            </button>

            <button
              className="secondary-button"
              onClick={goHome}
            >
              다른 게임 선택
            </button>
          </div>

        </div>
      </div>
    );
  }

  return (
    <div className="app">
      <div className="game-container">

        <header className="game-header">

          <button
            className="icon-button"
            onClick={goHome}
          >
            <ArrowLeft size={22} />
          </button>

          <div className="game-title">
            <span>
              {categoryInfo.emoji}
            </span>

            <div>
              <strong>
                {categoryInfo.title}
              </strong>

              <small>
                {currentIndex + 1} /{" "}
                {currentQuestions.length}
              </small>
            </div>
          </div>

          <div className="live-badge">
            <span className="live-dot"></span>
            LIVE
          </div>

        </header>

        <div className="progress-container">
          <div
            className="progress-bar"
            style={{
              width: `${progress}%`
            }}
          />
        </div>

        <section className="question-section">

          <div className="question-number">
            QUESTION {String(currentIndex + 1).padStart(2, "0")}
          </div>

          <h1>
            하나만 선택해야 한다면?
          </h1>

          <p>
            고민하지 말고 직감으로 선택하세요.
          </p>

        </section>

        <section className="battle">

          <div className="card-stack left-stack">

            <div className="card-back card-back-2"></div>
            <div className="card-back card-back-1"></div>

            <button
              className={`choice-card left-card ${
                selected[currentIndex] === "left"
                  ? "selected"
                  : ""
              }`}
              onClick={() => choose("left")}
              disabled={Boolean(selected[currentIndex])}
            >
              <div className="choice-label">
                A
              </div>

              <div className="choice-emoji">
                {currentQuestion.left.emoji}
              </div>

              <div className="choice-content">
                <span>OPTION A</span>

                <h2>
                  {currentQuestion.left.title}
                </h2>

                <p>
                  {currentQuestion.left.description}
                </p>
              </div>

              <div className="choice-footer">
                탭해서 선택
              </div>
            </button>
          </div>

          <div className="vs">
            <span>VS</span>
          </div>

          <div className="card-stack right-stack">

            <div className="card-back card-back-2"></div>
            <div className="card-back card-back-1"></div>

            <button
              className={`choice-card right-card ${
                selected[currentIndex] === "right"
                  ? "selected"
                  : ""
              }`}
              onClick={() => choose("right")}
              disabled={Boolean(selected[currentIndex])}
            >
              <div className="choice-label">
                B
              </div>

              <div className="choice-emoji">
                {currentQuestion.right.emoji}
              </div>

              <div className="choice-content">
                <span>OPTION B</span>

                <h2>
                  {currentQuestion.right.title}
                </h2>

                <p>
                  {currentQuestion.right.description}
                </p>
              </div>

              <div className="choice-footer">
                탭해서 선택
              </div>
            </button>
          </div>

        </section>

        <div className="game-hint">
          <span>💡</span>
          <p>
            선택하면 다음 질문으로 자동 이동합니다.
          </p>
        </div>

      </div>
    </div>
  );
}

