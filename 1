}

.category-card {
  position: relative;

  display: flex;
  align-items: center;
  gap: 16px;

  width: 100%;

  padding: 20px;

  border: 1px solid #e5e7eb;
  border-radius: 24px;

  background: rgba(255, 255, 255, 0.9);

  color: #111827;

  cursor: pointer;

  text-align: left;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border 0.2s ease;
}

.category-card:hover {
  transform: translateY(-5px);

  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.1);

  border-color: var(--category-color);
}

.category-card.active {
  border: 2px solid var(--category-color);
}

.category-icon {
  display: grid;
  place-items: center;

  flex-shrink: 0;

  width: 58px;
  height: 58px;

  border-radius: 18px;

  background: #f3f4f6;

  font-size: 30px;
}

.category-text {
  flex: 1;
}

.category-text h3 {
  margin: 0 0 5px;

  font-size: 17px;
}

.category-text p {
  margin: 0;

  color: #9ca3af;

  font-size: 12px;
}

/* QUICK START */

.quick-start {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 22px;

  padding: 20px 22px;

  border-radius: 24px;

  background: #111827;

  color: white;

  box-shadow:
    0 18px 50px rgba(15, 23, 42, 0.2);
}

.quick-start > div {
  display: flex;
  align-items: center;
  gap: 13px;
}

.quick-icon {
  display: grid;
  place-items: center;

  width: 45px;
  height: 45px;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #2563eb
    );
}

.quick-start strong {
  display: block;
  margin-bottom: 3px;
}

.quick-start small {
  color: #9ca3af;
}

.quick-start button {
  border: 0;

  background: white;
  color: #111827;

  padding: 12px 22px;

  border-radius: 13px;

  font-weight: 800;

  cursor: pointer;

  transition: transform 0.2s;
}

.quick-start button:hover {
  transform: scale(1.05);
}

footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;

  margin-top: 28px;

  color: #9ca3af;

  font-size: 12px;
}

/* =========================
   GAME
========================= */

.game-container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;

  padding: 24px 0 50px;
}

.game-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.icon-button {
  display: grid;
  place-items: center;

  width: 44px;
  height: 44px;

  border: 1px solid #e5e7eb;
  border-radius: 14px;

  background: white;

  color: #111827;

  cursor: pointer;
}

.game-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.game-title > span {
  font-size: 27px;
}

.game-title strong {
  display: block;
  font-size: 14px;
}

.game-title small {
  color: #9ca3af;
  font-size: 11px;
}

.progress-container {
  height: 5px;

  margin-top: 25px;

  background: #e5e7eb;

  border-radius: 999px;

  overflow: hidden;
}

.progress-bar {
  height: 100%;

  background:
    linear-gradient(
      90deg,
      #7c3aed,
      #2563eb
    );

  border-radius: inherit;

  transition: width 0.4s ease;
}

.question-section {
  text-align: center;

  padding: 70px 0 45px;
}

.question-number {
  color: #7c3aed;

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 0.15em;

  margin-bottom: 14px;
}

.question-section h1 {
  margin: 0;

  font-size: clamp(30px, 5vw, 52px);

  letter-spacing: -0.06em;
}

.question-section p {
  margin: 13px 0 0;

  color: #9ca3af;
}

/* =========================
   CARD BATTLE
========================= */

.battle {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    80px
    minmax(0, 1fr);

  align-items: center;

  max-width: 1000px;

  margin: 0 auto;
}

.card-stack {
  position: relative;

  min-height: 440px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.choice-card {
  position: relative;

  z-index: 5;

  width: min(100%, 400px);
  min-height: 440px;

  padding: 34px;

  border: 0;
  border-radius: 34px;

  color: white;

  text-align: left;

  cursor: pointer;

  overflow: hidden;

  box-shadow:
    0 30px 70px rgba(15, 23, 42, 0.18);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.choice-card:hover {
  transform: translateY(-12px) rotate(-1deg);

  box-shadow:
    0 40px 80px rgba(15, 23, 42, 0.25);
}

.choice-card.selected {
  transform:
    scale(1.04)
    translateY(-10px);

  box-shadow:
    0 45px 90px rgba(124, 58, 237, 0.35);
}

.left-card {
  background:
    linear-gradient(
      145deg,
      #ff6b6b,
      #e03131
    );
}

.right-card {
  background:
    linear-gradient(
      145deg,
      #4dabf7,
      #1971c2
    );
}

.choice-label {
  display: inline-grid;
  place-items: center;

  width: 38px;
  height: 38px;

  border-radius: 12px;

  background: rgba(255,255,255,0.2);

  font-weight: 900;
}

.choice-emoji {
  font-size: 88px;

  margin: 50px 0 35px;

  filter:
    drop-shadow(
      0 15px 15px
      rgba(0,0,0,0.15)
    );
}

.choice-content span {
  font-size: 10px;

  letter-spacing: 0.15em;

  font-weight: 900;

  opacity: 0.7;
}

.choice-content h2 {
  margin: 8px 0;

  font-size: 32px;

  letter-spacing: -0.05em;
}

.choice-content p {
  margin: 0;

  color: rgba(255,255,255,0.78);

  font-size: 14px;
}

.choice-footer {
  position: absolute;

  bottom: 28px;
  right: 30px;

  padding: 7px 11px;

  border-radius: 999px;

  background: rgba(0,0,0,0.15);

  font-size: 10px;

  font-weight: 700;
}

/* 카드 뒤에 깔리는 레이어 */

.card-back {
  position: absolute;

  width: min(100%, 370px);
  height: 420px;

  border-radius: 32px;

  opacity: 0.65;
}

.card-back-1 {
  transform:
    rotate(-5deg)
    translate(-15px, 12px);

  background: rgba(255,255,255,0.55);

  z-index: 2;
}

.card-back-2 {
  transform:
    rotate(-9deg)
    translate(-30px, 28px);

  background: rgba(255,255,255,0.3);

  z-index: 1;
}

.right-stack .card-back-1 {
  transform:
    rotate(5deg)
    translate(15px, 12px);
}

.right-stack .card-back-2 {
  transform:
    rotate(9deg)
    translate(30px, 28px);
}

/* VS */

.vs {
  position: relative;

  z-index: 10;

  display: grid;
  place-items: center;

  width: 62px;
  height: 62px;

  margin: 0 -10px;

  border-radius: 50%;

  background: #111827;

  color: white;

  font-size: 13px;
  font-weight: 900;

  box-shadow:
    0 15px 35px rgba(15,23,42,0.2);
}

.game-hint {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 7px;

  margin-top: 45px;

  color: #9ca3af;

  font-size: 12px;
}

.game-hint p {
  margin: 0;
}

/* =========================
   RESULT
========================= */

.result-container {
  width: min(700px, calc(100% - 32px));

  margin: 0 auto;

  padding: 30px 0 70px;
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  border: 0;

  background: transparent;

  color: #6b7280;

  cursor: pointer;

  font-weight: 600;
}

.result-header {
  text-align: center;

  padding: 65px 0 35px;
}

.trophy {
  display: grid;
  place-items: center;

  width: 76px;
  height: 76px;

  margin: 0 auto 20px;

  border-radius: 24px;

  background:
    linear-gradient(
      135deg,
      #f59e0b,
      #f97316
    );

  color: white;

  box-shadow:
    0 20px 40px rgba(245, 158, 11, 0.3);
}

.result-header > span {
  color: #9ca3af;

  font-size: 10px;

  letter-spacing: 0.2em;

  font-weight: 900;
}

.result-header h1 {
  margin: 10px 0;

  font-size: 44px;

  letter-spacing: -0.06em;
}

.result-header p {
  color: #6b7280;
}

/* result card */

.result-card {
  padding: 24px;

  border-radius: 28px;

  background: white;

  box-shadow:
    0 20px 60px rgba(15, 23, 42, 0.08);
}

.result-option {
  display: flex;
  align-items: center;
  gap: 15px;

  padding: 15px;

  border-radius: 20px;

  background: #f9fafb;
}

.result-option.winner {
  background: #f5f3ff;
}

.result-emoji {
  display: grid;
  place-items: center;

  width: 58px;
  height: 58px;

  border-radius: 17px;

  background: white;

  font-size: 30px;
}

.result-info span {
  display: block;

  color: #9ca3af;

  font-size: 9px;

  font-weight: 900;
}

.result-info strong {
  display: block;

  margin-top: 4px;

  font-size: 18px;
}

.result-score {
  display: grid;

  grid-template-columns:
    60px
    1fr
    60px;

  gap: 15px;

  align-items: center;

  margin-top: 25px;
}

.result-score > div:first-child {
  text-align: left;
}

.result-score > div:last-child {
  text-align: right;
}

.result-score span {
  display: block;

  color: #9ca3af;

  font-size: 9px;

  font-weight: 800;
}

.result-score strong {
  display: block;

  margin-top: 3px;

  font-size: 17px;
}

.result-bar {
  height: 10px;

  border-radius: 999px;

  overflow: hidden;

  background: #e5e7eb;
}

.result-left-bar {
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      #ff6b6b,
      #7c3aed
    );

  transition: width 1s ease;
}

.result-message {
  text-align: center;

  padding: 35px 0;
}

.result-message strong {
  font-size: 18px;
}

.result-message p {
  margin: 7px 0 0;

  color: #9ca3af;

  font-size: 13px;
}

.result-actions {
  display: grid;

  gap: 10px;
}

.primary-button,
.secondary-button {
  display: flex;
  justify-content: center;
  align-items: center;

  gap: 8px;

  width: 100%;

  min-height: 54px;

  border-radius: 17px;

  cursor: pointer;

  font-weight: 800;
}

.primary-button {
  border: 0;

  color: white;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #2563eb
    );
}

.secondary-button {
  border: 1px solid #e5e7eb;

  background: white;

  color: #374151;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {
  .home-container,
  .game-container {
    width: min(100% - 24px, 600px);
  }

  .hero {
    padding: 70px 0 45px;
  }

  .category-grid {
    grid-template-columns: 1fr;
  }

  .battle {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .card-stack {
    min-height: 390px;
  }

  .choice-card {
    min-height: 390px;
  }

  .choice-emoji {
    margin: 35px 0 25px;
    font-size: 70px;
  }

  .choice-content h2 {
    font-size: 27px;
  }

  .vs {
    width: 54px;
    height: 54px;

    margin: -62px auto;
  }

  .right-stack {
    margin-top: 20px;
  }

  .game-hint {
    margin-top: 35px;
  }
}

@media (max-width: 480px) {
  .home-container,
  .game-container,
  .result-container {
    width: calc(100% - 20px);
  }

  .hero h1 {
    font-size: 50px;
  }

  .hero p {
    font-size: 14px;
  }

  .quick-start {
    padding: 15px;
  }

  .quick-start button {
    padding: 10px 15px;
  }

  .choice-card {
    padding: 25px;
  }

  .choice-emoji {
    font-size: 65px;
  }

  .choice-content h2 {
    font-size: 25px;
  }

  .result-header h1 {
    font-size: 35px;
  }
}name: Deploy Balance Game

on:
  push:
    branches:
      - main

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build-and-deploy:

    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:

      - name: Checkout
        uses: actions/checkout@v6

      - name: Setup Node
        uses: actions/setup-node@v6
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Setup Pages
        uses: actions/configure-pages@v5

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: "./dist"

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
